NODE_ENV=development

# Postgres connection (postgres.js driver)
DATABASE_URL=postgres://app:app@localhost:5432/course_scheduling

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Public origin (inlined into the client bundle at build time)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# docker-compose postgres bootstrap
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=course_scheduling
