NODE_ENV=development

# Postgres connection (postgres.js driver). Use the SAME password as POSTGRES_PASSWORD below.
DATABASE_URL=postgres://app:CHANGE_ME_strong_password@localhost:5432/course_scheduling

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Public origin (inlined into the client bundle at build time)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Anthropic (Claude) — REQUIRED for AI-drafted progress reports (/dashboard/reports → 生成草稿).
# Without it, drafting is disabled and the UI shows a readable error instead of failing.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8   # optional; default is claude-opus-4-8

# 报告起草 provider 切换:anthropic(默认)| minimax
# REPORT_PROVIDER=anthropic

# MiniMax(中国区)— REPORT_PROVIDER=minimax 时用于 AI 起草进度报告。
# 注意:CN Key 必须配 api.minimaxi.com(尾字母 i);区域与 Key 不匹配会 404/鉴权失败。
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-M3                      # optional; default is MiniMax-M3
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1  # optional; CN default

# docker-compose postgres bootstrap.
# POSTGRES_PASSWORD is REQUIRED (compose fails to start without it) — set a strong value.
# The compose Postgres port is bound to 127.0.0.1 only; override host port via POSTGRES_HOST_PORT.
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=course_scheduling
