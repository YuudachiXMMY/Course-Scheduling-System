NODE_ENV=development

# Postgres connection (postgres.js driver). Use the SAME password as POSTGRES_PASSWORD below.
DATABASE_URL=postgres://app:CHANGE_ME_strong_password@localhost:5432/course_scheduling

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Public origin (inlined into the client bundle at build time)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# docker-compose postgres bootstrap.
# POSTGRES_PASSWORD is REQUIRED (compose fails to start without it) — set a strong value.
# The compose Postgres port is bound to 127.0.0.1 only; override host port via POSTGRES_HOST_PORT.
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=course_scheduling
