{
  "name": "course-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint",
    "auth:generate": "npx --yes auth@latest generate --config ./src/auth/auth.ts --output ./src/db/auth-schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@better-auth/drizzle-adapter": "1.7.4",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@modelcontextprotocol/server": "^2.0.0",
    "@react-pdf/renderer": "^4.9.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@touch4it/ical-timezones": "^1.9.0",
    "archiver": "^8.0.0",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "ical-generator": "^11.1.1",
    "luxon": "3.7.2",
    "mcp-handler": "^2.1.1",
    "nanoid": "^5.1.5",
    "next": "16.3.5",
    "openai": "^7.15.0",
    "playwright": "^1.63.0",
    "postgres": "3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rrule": "2.8.1",
    "server-only": "^0.0.1",
    "zod": "4.6.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.25",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.6",
    "tailwindcss": "^4",
    "tsx": "^4.19",
    "typescript": "~5.9",
    "vite-tsconfig-paths": "^5",
    "vitest": "^3"
  }
}
