# E2E test configuration — copy to `.env.e2e` (gitignored) and fill in for local runs.
# global-setup (tests/e2e/global-setup.ts) and the seed (scripts/seed-e2e.ts) read these.
# In CI these are provided as workflow env vars instead of a file.

# Where the running app is reachable (baseURL for Playwright + BETTER_AUTH_URL for the seed).
E2E_BASE_URL=http://localhost:3000

# Postgres the app reads from — the seed writes DIRECTLY here so fixtures are visible to the app.
# Local docker-compose maps Postgres to a HOST port (often 5433, or 5432). Use the app's DB.
# Get the current dev password with:
#   docker inspect course-scheduling-postgres-1 --format '{{range .Config.Env}}{{println .}}{{end}}' | grep POSTGRES_PASSWORD
E2E_DATABASE_URL=postgres://app:CHANGE_ME@127.0.0.1:5433/course_scheduling

# Any string ≥ 32 chars — only needs to satisfy env validation in the seed process. It does NOT need
# to match the app's secret (the seed never mints cookies; storageState is captured by signing in
# against the running app, which signs cookies with ITS own secret).
E2E_BETTER_AUTH_SECRET=e2e-insecure-secret-override-me-0123456789
